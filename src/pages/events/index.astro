---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { url } from '../../content/site';
import { club } from '../../content/public';
import UpcomingEvents from '../../components/UpcomingEvents.astro';
import EventCarousel from '../../components/EventCarousel.astro';
import '../../styles/events.css';
---

<SiteLayout
  title="Events & Yatra"
  description="Past Yatra editions, robotics competitions and club activities at National College of Engineering."
  section="events"
>
  <section class="events-page container" aria-labelledby="events-title">
    <h1 id="events-title">Events &amp; Yatra.</h1>
    <div class="event-showcase">
      <div class="event-showcase-copy">
        <p class="event-date">{club.events.yatra5.dates}</p>
        <h2>Yatra 5.0</h2>
        <p>Robots, projects and the people behind them.</p>
        <a class="button primary compact" href={url('/events/yatra-5/')}>
          Explore Yatra 5.0
        </a>
        <div class="events-notice">
          <h3>Upcoming events</h3>
          <UpcomingEvents />
        </div>
      </div>
      <EventCarousel
        id="events-feature-photos"
        photos={club.events.yatra5.photos}
        label="Yatra 5.0 event photographs"
        compact
        priority
        destination="/events/yatra-5/"
      />
    </div>
    <section class="event-collections" aria-labelledby="past-editions-title">
      <h2 id="past-editions-title">Past editions</h2>
      <ul class="edition-list">
        {club.events.editions.map((edition, index) => (
          <li
            class:list={[
              'edition-card',
              { 'edition-card--photos': index === 0 },
            ]}
          >
            <div
              class={`edition-cover edition-cover--${index}`}
              aria-hidden="true"
            >
              {index === 0 ? (
                <img
                  src={url('/images/yatra-nce-robot-800.webp')}
                  alt=""
                  width="800"
                  height="1199"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="edition-number">
                  {['05', '04', '03', '02', '01'][index]}
                </span>
              )}
            </div>
            <div class="edition-caption">
              <h3>{edition.label}</h3>
              <a
                class="edition-link"
                href={
                  edition.href.startsWith('/')
                    ? url(edition.href)
                    : edition.href
                }
                target={edition.href.startsWith('/') ? undefined : '_blank'}
                rel={
                  edition.href.startsWith('/')
                    ? undefined
                    : 'noopener noreferrer'
                }
              >
                See more <span aria-hidden="true">↗</span>
                <span class="sr-only">
                  {' '}
                  for {edition.label}
                  {edition.href.startsWith('/') ? '' : ' (opens in a new tab)'}
                </span>
              </a>
            </div>
          </li>
        ))}
      </ul>
    </section>
  </section>
</SiteLayout>
