---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { withBase } from '../../components/paths';
import { siteConfig } from '../../content/site';
import { club } from '../../content/public';
import EventCarousel from '../../components/EventCarousel.astro';
import '../../styles/events.css';

const yatra = club.events.yatra5;
const url = (path: string) => withBase(path, siteConfig.basePath);
---

<SiteLayout
  title="Yatra 5.0"
  description="NCE Yatra 5.0, 31 July–1 August 2026: project demonstrations, robotics competitions and exhibition photographs."
  section="events"
>
  <section class="yatra5-page container" aria-labelledby="yatra5-title">
    <a class="event-back" href={url('/events/')}>
      <span aria-hidden="true">←</span> Events
    </a>
    <div class="event-detail-intro">
      <div>
        <h1 id="yatra5-title">Yatra 5.0.</h1>
        <p class="event-date">{yatra.dates}</p>
        <div class="event-tracks" aria-label="Competition tracks">
          {yatra.activities.split(' · ').map((activity) => (
            <span>{activity}</span>
          ))}
        </div>
      </div>
      <div class="event-recap">
        <dl class="event-figures">
          {yatra.reported.split(' · ').map((figure) => {
            const space = figure.indexOf(' ');
            return (
              <div>
                <dt>{figure.slice(space + 1)}</dt>
                <dd>{figure.slice(0, space)}</dd>
              </div>
            );
          })}
        </dl>
        <p class="small muted">
          Figures reported by National College of Engineering.
        </p>
        <a
          class="arrow-link"
          href={yatra.recapUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          College recap <span aria-hidden="true">↗</span>
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      </div>
    </div>
    <EventCarousel
      id="yatra-event-photos"
      photos={yatra.photos}
      label="Yatra 5.0 photo collection"
      priority
      viewer
    />
    <div class="hero-actions yatra5-actions">
      <a class="button primary compact" href={url('/events/')}>
        Back to events
      </a>
      <a
        class="button outline"
        href={yatra.recapUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        View college recap<span class="sr-only"> (opens in a new tab)</span>
      </a>
    </div>
  </section>
  <dialog id="photo-viewer" class="photo-viewer" aria-label="Yatra photograph">
    <div class="viewer-inner">
      <div>
        <button type="button" class="button outline" data-viewer-close>
          Close photo
        </button>
      </div>
      <div class="viewer-frame">
        <img
          data-viewer-image
          alt=""
          width="1400"
          height="934"
          decoding="async"
        />
        <p data-viewer-error class="photo-unavailable" hidden>
          Photo unavailable
        </p>
      </div>
      <p class="sr-only" data-viewer-caption></p>
      <p class="viewer-count" data-viewer-count></p>
      <div class="viewer-actions">
        <button type="button" class="button outline" data-viewer-prev>
          Previous
        </button>
        <button type="button" class="button outline" data-viewer-next>
          Next
        </button>
      </div>
    </div>
  </dialog>
  <script>
    import '../../features/gallery/viewer';
  </script>
</SiteLayout>
