---
import SiteLayout from '../layouts/SiteLayout.astro';
import { withBase } from '../components/paths';
import { siteConfig } from '../content/site';

const url = (path: string) => withBase(path, siteConfig.basePath);
const campusSrcSet = [480, 800, 1400]
  .map(
    (width) =>
      `${url(`/images/events-yatra-campus${width === 1400 ? '' : `-${width}`}.webp`)} ${width}w`,
  )
  .join(', ');
---

<SiteLayout
  title="About"
  description="The student-led robotics club at National College of Engineering, Lalitpur."
  section="about"
>
  <section class="container about-page" aria-labelledby="about-heading">
    <p class="eyebrow page-label">About the club</p>
    <h1 id="about-heading">Robotics, together.</h1>
    <p class="page-lead">
      The student-led robotics club at National College of Engineering.
    </p>
    <img
      class="about-feature-photo"
      src={url('/images/events-yatra-campus.webp')}
      srcset={campusSrcSet}
      sizes="(max-width: 639px) calc(100vw - 40px), (max-width: 1199px) calc(100vw - 64px), 1328px"
      width="1400"
      height="934"
      decoding="async"
      fetchpriority="high"
      alt="National College of Engineering campus during Yatra 5.0"
    />
    <div class="about-community">
      <h2 class="section-title">
        A place to build <br />
        and contribute.
      </h2>
      <div class="about-copy">
        <p class="body-large">
          We build projects, run technical activities and compete in robotics.
        </p>
        <p class="muted">
          Block B, National College of Engineering, Talchhikhel, Lalitpur.
        </p>
      </div>
    </div>
    <div class="page-actions about-actions">
      <a class="button primary compact" href={url('/team/')}>
        Meet the committee
      </a>
      <a class="button outline compact" href={url('/projects/')}>
        See our projects
      </a>
    </div>
  </section>
</SiteLayout>
