---
import type { Member } from '../content/public';
import { url } from '../content/site';
interface Props {
  member: Member;
}
const { member } = Astro.props;
---

{member.socials.length > 0 && (
  <div class="member-socials" aria-label={`${member.name} social profiles`}>
    {member.socials.map((profile) => (
      <a
        href={profile.url}
        class="member-social-link"
        aria-label={`${member.name} on ${profile.label}`}
      >
        <img
          src={url(`/icons/${profile.label.toLowerCase()}.svg`)}
          alt=""
          width="28"
          height="28"
          loading="lazy"
        />
      </a>
    ))}
  </div>
)}
