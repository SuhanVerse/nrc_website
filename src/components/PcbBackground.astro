---
interface Props {
  variant?: 'hero' | 'yatra';
}

const { variant = 'hero' } = Astro.props;
const patternId = `pcb-crosses-${variant}`;
---

<div class={`pcb-scene pcb-scene--${variant}`} aria-hidden="true">
  <div class="pcb-dots"></div>
  {variant === 'hero' ? (
    <svg
      class="pcb-svg"
      viewBox="0 0 1328 680"
      preserveAspectRatio="xMidYMid slice"
      focusable="false"
    >
      <defs>
        <pattern
          id={patternId}
          width="80"
          height="80"
          patternUnits="userSpaceOnUse"
        >
          <path
            d="M76 80h8M80 76v8"
            stroke="currentColor"
            stroke-width="1.1"
            stroke-opacity="0.28"
          />
        </pattern>
      </defs>
      <rect
        class="pcb-cross-field"
        width="1328"
        height="680"
        fill={`url(#${patternId})`}
      />
      <g class="pcb-traces-desktop">
        <path
          d="M684 34h64l26 26h492l24 24v492l-26 26H896l-22 22v32"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-opacity="0.30"
        />
        <path
          d="M704 20h56l26 26h488l28 28v464"
          fill="none"
          stroke="currentColor"
          stroke-width="1.1"
          stroke-opacity="0.18"
        />
        <path
          d="M24 612h154l24-24h88"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-opacity="0.26"
        />
        <circle
          cx="684"
          cy="34"
          r="4.5"
          fill="#f7f7f4"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-opacity="0.38"
        />
        <circle
          cx="704"
          cy="20"
          r="4.5"
          fill="#f7f7f4"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-opacity="0.30"
        />
        <circle
          cx="290"
          cy="588"
          r="4.5"
          fill="#f7f7f4"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-opacity="0.34"
        />
        <circle
          cx="1290"
          cy="318"
          r="4.5"
          fill="#f7f7f4"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-opacity="0.38"
        />
        <circle
          cx="988"
          cy="602"
          r="4.5"
          fill="#f7f7f4"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-opacity="0.38"
        />
      </g>
    </svg>
  ) : (
    <svg
      class="pcb-svg"
      viewBox="0 0 1328 560"
      preserveAspectRatio="xMidYMid slice"
      focusable="false"
    >
      <defs>
        <pattern
          id={patternId}
          width="80"
          height="80"
          patternUnits="userSpaceOnUse"
        >
          <path
            d="M76 80h8M80 76v8"
            stroke="currentColor"
            stroke-width="1.1"
            stroke-opacity="0.24"
          />
        </pattern>
      </defs>
      <rect
        class="pcb-cross-field"
        width="1328"
        height="560"
        fill={`url(#${patternId})`}
      />
      <g class="pcb-traces-desktop">
        <path
          d="M668 42h-84l-24 24H64l-24 24v370l26 26h394l26 26v24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-opacity="0.26"
        />
        <path
          d="M648 28h-76l-24 24H52l-26 26v352"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-opacity="0.16"
        />
        <circle
          cx="668"
          cy="42"
          r="4.5"
          fill="#f7f7f4"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-opacity="0.34"
        />
        <circle
          cx="40"
          cy="260"
          r="4.5"
          fill="#f7f7f4"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-opacity="0.34"
        />
        <circle
          cx="320"
          cy="486"
          r="4.5"
          fill="#f7f7f4"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-opacity="0.34"
        />
      </g>
    </svg>
  )}
</div>
