---
import { url } from '../content/site';
const photos = [
  { name: 'projectile-turret', caption: 'Projectile Turret at Yatra' },
  { name: 'object-sorting', caption: 'Object Sorting System demonstration' },
  { name: 'workbench', caption: 'Project workbench at the exhibition' },
];
---

<figure class="gallery" data-gallery>
  <div class="photo-window">
    {photos.map((photo, i) => (
      <img
        class:list={{ 'photo-active': i === 0 }}
        src={i === 0 ? url(`/images/${photo.name}-800.webp`) : undefined}
        srcset={
          i === 0
            ? [480, 800, 1400]
                .map(
                  (width) =>
                    `${url(`/images/${photo.name}${width === 1400 ? '' : `-${width}`}.webp`)} ${width}w`,
                )
                .join(', ')
            : undefined
        }
        data-src={url(`/images/${photo.name}-800.webp`)}
        data-srcset={[480, 800, 1400]
          .map(
            (width) =>
              `${url(`/images/${photo.name}${width === 1400 ? '' : `-${width}`}.webp`)} ${width}w`,
          )
          .join(', ')}
        sizes="(max-width: 639px) calc(100vw - 40px), (max-width: 999px) calc(100vw - 64px), 46vw"
        alt={photo.caption}
        data-caption={photo.caption}
        width="1400"
        height="933"
        fetchpriority={i === 0 ? 'high' : undefined}
        decoding="async"
        aria-hidden={i === 0 ? undefined : 'true'}
      />
    ))}
    <p class="photo-unavailable" data-gallery-error hidden>
      Photo unavailable
    </p>
  </div>
  <figcaption data-gallery-caption>{photos[0].caption}</figcaption>
  <div
    class="gallery-navigation"
    data-gallery-navigation
    role="group"
    aria-label="Choose a photograph"
    aria-describedby="gallery-navigation-hint"
    hidden
  >
    {photos.map((_, index) => (
      <button
        type="button"
        class="gallery-dot"
        data-gallery-select={index}
        aria-label={`Show photo ${index + 1}`}
        aria-pressed={index === 0 ? 'true' : 'false'}
      >
        <span aria-hidden="true"></span>
      </button>
    ))}
  </div>
  <p class="sr-only" id="gallery-navigation-hint">
    Choosing a photo stops automatic rotation until you reload the page.
  </p>
  <p class="sr-only" role="status" data-gallery-status></p>
</figure>

<style>
  .gallery {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 12px;
  }

  .photo-window {
    grid-column: 1 / -1;
  }

  .gallery-navigation {
    display: flex;
    margin-top: 4px;
  }

  .gallery-dot {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }

  .gallery-dot span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--muted);
  }

  .gallery-dot[aria-pressed='true'] span {
    width: 6px;
    height: 6px;
    background: var(--ink);
  }
</style>
<script>
  import '../features/gallery/carousel';
</script>
