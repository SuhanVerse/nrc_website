---
import { club } from '../content/public';
import { navigation, siteConfig, url } from '../content/site';
import Logo from './Logo.astro';
const identity = club.club;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-identity">
      <a href={url('/')} aria-label="NCE Robotics Club home">
        <Logo />
      </a>
      <p class="footer-name">{identity.name}</p>
      <p>{identity.college}</p>
    </div>
    <div>
      <h2>Explore</h2>
      <nav aria-label="Footer navigation">
        {navigation.map(([label, path]) => (
          <a href={url(path)}>{label}</a>
        ))}
      </nav>
    </div>
    <div>
      <h2>Contact the club</h2>
      <a class="email-link" href={`mailto:${identity.email}`}>
        {identity.email}
      </a>
      <p class="address">
        {identity.location}
        <br />
        {identity.address}
      </p>
      <a class="footer-map" href={siteConfig.mapUrl}>
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"
        >
          <path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z" />
          <circle cx="12" cy="10" r="2.5" />
        </svg>
        View on map <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div>
      <h2>Connect</h2>
      <div class="socials">
        {identity.socials.map((s) => (
          <a
            class="social-link"
            href={s.url}
            aria-label={`NCE Robotics Club on ${s.label}`}
          >
            <img
              src={url(`/icons/${s.label.toLowerCase()}.svg`)}
              alt=""
              width="44"
              height="44"
              loading="lazy"
            />
          </a>
        ))}
        <a
          class="social-link"
          href={`mailto:${identity.email}`}
          aria-label="Email NCE Robotics Club"
        >
          <img
            src={url('/icons/gmail.svg')}
            alt=""
            width="44"
            height="44"
            loading="lazy"
          />
        </a>
      </div>
      <a
        class="college-link"
        href="https://nce.edu.np/"
        aria-label="National College of Engineering website"
      >
        <img
          src={url('/images/college-logo.webp')}
          alt="National College of Engineering"
          width="240"
          height="107"
          loading="lazy"
        />
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
  <div class="container footer-bottom">
    © {new Date().getFullYear()} NCE Robotics Club · National College of
    Engineering
  </div>
</footer>
