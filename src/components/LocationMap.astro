---
interface Props {
  wide?: boolean;
}
const { wide = false } = Astro.props;
---

<div class:list={['location-map', { 'location-map--wide': wide }]}>
  <iframe
    src="https://maps.google.com/maps?q=National%20College%20of%20Engineering%2C%20Talchhikhel%2C%20Lalitpur%2C%20Nepal&t=m&z=15&output=embed&iwloc=near"
    title="National College of Engineering, Lalitpur location map"
    width={wide ? 640 : 320}
    height={wide ? 480 : 320}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>
</div>

<style>
  .location-map {
    width: 100%;
    max-width: 320px;
    aspect-ratio: 1;
    margin-top: 20px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--paper);
  }

  .location-map--wide {
    max-width: none;
    aspect-ratio: 4 / 3;
    margin-top: 0;
  }

  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  iframe:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: -4px;
  }
</style>
